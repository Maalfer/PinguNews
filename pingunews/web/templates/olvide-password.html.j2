<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Recuperar contraseña — PinguNews</title>
{% include "_favicon.html.j2" %}
{% include "_estilos.html.j2" %}
</head>
<body class="auth-body">
  {% import "_macros.html.j2" as m %}
  <main class="auth-main" id="contenido">
    <div class="auth-escena">
      {% set f = frase_aleatoria() %}
      <aside class="auth-lado">
        <figure class="auth-pensar" aria-label="Frase motivadora">
          <blockquote><p id="bq-texto">{{ f.texto }}</p></blockquote>
          <figcaption id="bq-autor"{% if not f.autor %} hidden{% endif %}>{{ f.autor }}</figcaption>
          <button type="button" class="bq-otra" id="bq-otra" hidden aria-label="Mostrar otra frase">
            <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11a8 8 0 0 0-14.5-4M4 4v4h4M4 13a8 8 0 0 0 14.5 4M20 20v-4h-4"/></svg>
          </button>
          <span class="auth-pensar-cola" aria-hidden="true"><i></i><i></i></span>
        </figure>
        <div class="auth-pingu" aria-hidden="true">{{ m.pingu(116) }}</div>
      </aside>

      <div class="auth-card">
        <p class="auth-marca">PinguNews</p>
        <h1>Recuperar contraseña</h1>

        {% if mensaje %}
        <p class="auth-sub">Hemos recibido tu solicitud.</p>
        <p class="auth-exito" role="status"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg><span>{{ mensaje }}</span></p>
        <a class="btn-ghost btn-bloque" href="/login">Volver a iniciar sesión</a>
        {% else %}
        <p class="auth-sub">Introduce el correo con el que te registraste y te enviaremos un enlace para elegir una contraseña nueva.</p>

        {% if error %}<p class="auth-error" id="auth-error" role="alert"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.4v.1"/></svg><span>{{ error }}</span></p>{% endif %}

        <form method="post" action="/olvide-password">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
          <div class="campo">
            <label for="email">Correo electrónico</label>
            <div class="campo-caja">
              <svg class="campo-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M4 7l8 6 8-6"/></svg>
              <input type="email" id="email" name="email" autocomplete="email" maxlength="254" required{% if error %} aria-describedby="auth-error"{% endif %}>
            </div>
          </div>
          <button type="submit" class="btn btn-primario btn-grande">Enviar enlace</button>
        </form>

        <div class="auth-separador" aria-hidden="true"><span>o</span></div>
        <a class="btn-ghost btn-bloque" href="/login">Volver a iniciar sesión</a>
        {% endif %}
      </div>

      <p class="auth-volver"><a class="btn-ghost" href="/">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
        Volver al panel
      </a></p>
    </div>
  </main>
  {% include "_footer.html.j2" %}
  {% include "_auth_script.html.j2" %}
</body>
</html>
