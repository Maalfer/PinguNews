{% extends "_base.html.j2" %}
{% block titulo %}Mi perfil — PinguNews{% endblock %}
{% block titulo_pagina %}👤 Mi perfil{% endblock %}
{% block subtitulo_pagina %}<span class="subtitulo">gestiona tu usuario, correo y contraseña</span>{% endblock %}

{% block main %}
  <main class="wrap" id="contenido" tabindex="-1">
    <div class="perfil-grid">

    <section class="perfil-card" aria-labelledby="perfil-usuario-h">
      <h2 id="perfil-usuario-h"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg> Nombre de usuario</h2>
      <p class="campo-sub">Usuario actual: <strong>{{ usuario.nombre_usuario }}</strong></p>
      {% if seccion == 'usuario' and error %}<p class="auth-error" role="alert"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.4v.1"/></svg><span>{{ error }}</span></p>{% endif %}
      {% if seccion == 'usuario' and mensaje %}<p class="auth-exito" role="status"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg><span>{{ mensaje }}</span></p>{% endif %}
      <form method="post" action="/perfil/usuario">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="campo">
          <label for="nombre_usuario_nuevo">Nuevo nombre de usuario</label>
          <input type="text" id="nombre_usuario_nuevo" name="nombre_usuario_nuevo" value="{{ usuario.nombre_usuario }}" minlength="3" maxlength="32" autocomplete="username" autocapitalize="none" spellcheck="false" required>
        </div>
        <div class="campo">
          <label for="password_actual_usuario">Confirma tu contraseña actual</label>
          <input type="password" id="password_actual_usuario" name="password_actual" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-primario">Guardar nombre de usuario</button>
      </form>
    </section>

    <section class="perfil-card" aria-labelledby="perfil-email-h">
      <h2 id="perfil-email-h"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M4 7l8 6 8-6"/></svg> Correo electrónico</h2>
      <p class="campo-sub">
        {% if usuario.email %}Correo actual: <strong>{{ usuario.email }}</strong>
        {% else %}No tienes un correo configurado todavía. Añade uno para poder recuperar tu contraseña si la olvidas.{% endif %}
      </p>
      {% if seccion == 'email' and error %}<p class="auth-error" role="alert"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.4v.1"/></svg><span>{{ error }}</span></p>{% endif %}
      {% if seccion == 'email' and mensaje %}<p class="auth-exito" role="status"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg><span>{{ mensaje }}</span></p>{% endif %}
      <form method="post" action="/perfil/email">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="campo">
          <label for="email_nuevo">{{ 'Correo nuevo' if usuario.email else 'Correo' }}</label>
          <input type="email" id="email_nuevo" name="email_nuevo" maxlength="254" autocomplete="email" required>
        </div>
        <div class="campo">
          <label for="password_actual_email">Confirma tu contraseña actual</label>
          <input type="password" id="password_actual_email" name="password_actual" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-primario">{{ 'Cambiar correo' if usuario.email else 'Añadir correo' }}</button>
      </form>
      <p class="campo-ayuda">Te enviaremos un enlace de confirmación a la dirección nueva; el cambio no se aplica hasta que lo confirmes.</p>
    </section>

    <section class="perfil-card" aria-labelledby="perfil-password-h">
      <h2 id="perfil-password-h"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg> Contraseña</h2>
      {% if seccion == 'password' and error %}<p class="auth-error" role="alert"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.4v.1"/></svg><span>{{ error }}</span></p>{% endif %}
      {% if seccion == 'password' and mensaje %}<p class="auth-exito" role="status"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg><span>{{ mensaje }}</span></p>{% endif %}
      <form method="post" action="/perfil/password">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <div class="campo">
          <label for="password_actual">Contraseña actual</label>
          <input type="password" id="password_actual" name="password_actual" autocomplete="current-password" required>
        </div>
        <div class="campo">
          <label for="password_nueva">Contraseña nueva</label>
          <input type="password" id="password_nueva" name="password_nueva" autocomplete="new-password" minlength="8" required>
        </div>
        <div class="campo">
          <label for="password_nueva2">Repite la contraseña nueva</label>
          <input type="password" id="password_nueva2" name="password_nueva2" autocomplete="new-password" minlength="8" required>
        </div>
        <button type="submit" class="btn btn-primario">Cambiar contraseña</button>
      </form>
      <p class="campo-ayuda">Cambiar la contraseña cierra cualquier otra sesión que tengas abierta en otros dispositivos.</p>
    </section>

    </div>
  </main>
{% endblock %}
