{% extends "_base.html.j2" %}
{% block titulo %}{{ titulo }} — PinguNews{% endblock %}
{% block body_class %}auth-body{% endblock %}
{% block header %}{% endblock %}

{% block main %}
  <main class="auth-main" id="contenido">
    <div class="auth-escena">
      <div class="auth-pingu" aria-hidden="true">{{ m.pingu(116) }}</div>
      <div class="auth-card error-card">
        <p class="auth-marca">Error 404</p>
        <h1>No encontramos esa página</h1>
        <p class="auth-sub">Puede que el enlace esté mal escrito o que la página ya no exista.</p>
        <a class="btn btn-primario btn-grande btn-bloque" href="/">Ir al panel de noticias</a>
      </div>
    </div>
  </main>
{% endblock %}
