{% extends "_auth_base.html.j2" %}
{% block titulo %}Iniciar sesión — PinguNews{% endblock %}

{% block auth_card %}
<p class="auth-marca">PinguNews</p>
<h1>Bienvenido de nuevo</h1>
<p class="auth-sub">Entra para guardar noticias y darles me gusta.</p>

{% if error %}<p class="auth-error" id="auth-error" role="alert"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.4v.1"/></svg><span>{{ error }}</span></p>{% endif %}
{% if mensaje %}<p class="auth-exito" role="status"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg><span>{{ mensaje }}</span></p>{% endif %}

<form method="post" action="/login">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <div class="campo">
    <label for="nombre_usuario">Usuario</label>
    <div class="campo-caja">
      <svg class="campo-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
      <input type="text" id="nombre_usuario" name="nombre_usuario" autocomplete="username" autocapitalize="none" spellcheck="false" required{% if error %} aria-describedby="auth-error"{% endif %}>
    </div>
  </div>
  <div class="campo">
    <label for="password">Contraseña</label>
    <div class="campo-caja">
      <svg class="campo-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
      <input type="password" id="password" name="password" data-pw autocomplete="current-password" required{% if error %} aria-describedby="auth-error"{% endif %}>
      <button type="button" class="btn-ojo" data-for="password" data-nombre="contraseña" hidden aria-pressed="false" aria-label="Mostrar contraseña"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button>
    </div>
    <p class="campo-ayuda campo-ayuda-enlace"><a href="/olvide-password">¿Olvidaste tu contraseña?</a></p>
  </div>
  <button type="submit" class="btn btn-primario btn-grande">Entrar</button>
</form>

<div class="auth-separador" aria-hidden="true"><span>o</span></div>
<p class="auth-enlace">¿Todavía no tienes cuenta?</p>
<a class="btn-ghost btn-bloque" href="/registro">Crear una cuenta</a>
{% endblock %}
