{% extends "_auth_base.html.j2" %}
{% block titulo %}Revisa tu correo — PinguNews{% endblock %}

{% block auth_card %}
<p class="auth-marca">PinguNews</p>
<h1>Revisa tu correo</h1>
<p class="auth-sub">
  {% if reenviado %}Te hemos enviado otro enlace a{% else %}Te hemos enviado un enlace de verificación a{% endif %}
  <strong>{{ email }}</strong>. Ábrelo para activar tu cuenta (caduca en 24 horas).
</p>

<form method="post" action="/reenviar-verificacion">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <input type="hidden" name="token" value="{{ token }}">
  <button type="submit" class="btn btn-primario btn-grande">Reenviar correo</button>
</form>

<div class="auth-separador" aria-hidden="true"><span>o</span></div>
<a class="btn-ghost btn-bloque" href="/login">Ya verifiqué, iniciar sesión</a>
{% endblock %}
