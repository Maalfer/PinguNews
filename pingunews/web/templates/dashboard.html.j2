{% extends "_base.html.j2" %}

{% block head_extra %}
<noscript><style>.cat-body{grid-template-rows:1fr !important}.cat-body[hidden]{content-visibility:visible !important;display:grid !important}.cat-body>.cat-grid{opacity:1 !important}.cat-header{cursor:default}</style></noscript>
{% endblock %}

{% block header_extra %}
<div class="panel-controles">
  <div class="grupo-control grupo-filtros">
    <div class="filtros-grid">
      <div class="filtro">
        <span class="grupo-control-titulo" id="titulo-rango">Rango de fechas</span>
        <nav class="dias-selector" aria-labelledby="titulo-rango">
        <ul>
          {% for opcion in opciones_dias %}
          <li>
            <a href="?dias={{ opcion }}{{ categorias_qs }}"{% if opcion == dias %} aria-current="page"{% endif %}>
              {{ opcion }}d<span class="sr-only">: {{ 'último día' if opcion == 1 else 'últimos ' ~ opcion ~ ' días' }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </nav>
      </div>
      <div class="filtro">
        <span class="grupo-control-titulo" id="titulo-cats">Categorías</span>
        <details class="dropdown">
      <summary class="btn-ghost dropdown-btn" aria-describedby="titulo-cats">
        {{ categorias_activas | length }} de {{ categorias_disponibles | length }} seleccionadas
      </summary>
      <div class="dropdown-panel">
        <form method="get" action="/">
          <fieldset>
            <legend class="grupo-control-titulo">Elige qué categorías mostrar</legend>
            <input type="hidden" name="dias" value="{{ dias }}">
            {% if q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}
            <div class="fila-categorias">
              <ul class="lista-categorias">
                {% for cat, label in categorias_disponibles %}
                <li>
                  <label class="chip" title="{{ label }}">
                    <input type="checkbox" name="categorias" value="{{ cat }}" {{ 'checked' if cat in categorias_activas else '' }}>
                    <span class="chip-txt">{{ label.split(' (')[0] | emoji_decorativo }}</span>
                    <span class="chip-n">{{ conteo_por_categoria.get(cat, 0) }}</span>
                  </label>
                </li>
                {% endfor %}
              </ul>
              <div class="fila-aplicar">
                <button class="btn btn-primario" type="submit">Aplicar</button>
                <a class="btn-ghost" href="/?dias={{ dias }}{% if q %}&amp;q={{ q | urlencode }}{% endif %}">Ver todas</a>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </details>
      </div>
      <form class="filtros-actualizar" id="form-actualizar" method="post" action="/actualizar?dias={{ dias }}{{ categorias_qs }}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <button class="btn btn-primario" type="submit"><span aria-hidden="true">↻</span> Actualizar ahora</button>
      </form>
    </div>
  </div>

  <div class="grupo-control grupo-buscador">
    <search class="buscador" aria-label="Buscar noticias">
      <form class="buscador-form" method="get" action="/">
        <input type="hidden" name="dias" value="{{ dias }}">
        {% if categorias_activas | length != categorias_disponibles | length %}{% for c in categorias_activas %}<input type="hidden" name="categorias" value="{{ c }}">{% endfor %}{% endif %}
        <label class="sr-only" for="buscar">Buscar noticias por palabras</label>
        <div class="buscador-barra">
          <svg class="ico buscador-lupa" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
          <input class="buscador-input" id="buscar" type="search" name="q" value="{{ q }}" maxlength="100"
                 placeholder="Buscar por título, resumen, fuente…" autocomplete="off" enterkeyhint="search">
          {% if q %}<a class="buscador-limpiar" href="/?dias={{ dias }}{{ categorias_qs.replace('&q=' ~ (q | urlencode), '') }}" aria-label="Limpiar búsqueda" title="Limpiar búsqueda"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg></a>{% endif %}
          <button class="btn btn-primario buscador-btn" type="submit">Buscar</button>
        </div>
      </form>
      {% if q %}<p class="buscador-estado" role="status"><strong>{{ total_items }}</strong> {{ 'resultado' if total_items == 1 else 'resultados' }} para «{{ q }}»</p>{% endif %}
    </search>
  </div>

  {% set f = frase_aleatoria() %}
  <div class="grupo-control grupo-frase">
    <div class="mascota-caja">
      <button type="button" class="mascota" id="mascota" title="¡Haz clic!"
              aria-label="Pingüino mascota. Púlsalo para verlo hacer una animación">
        {{ m.pingu(100, 'hola') }}
      </button>
      <button type="button" class="mascota-pausa" id="mascota-pausa" aria-pressed="false"
              aria-label="Pausar las animaciones automáticas del pingüino" title="Pausar animaciones automáticas">
        <svg class="ico ico-pausa" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5v14M15 5v14"/></svg>
        <svg class="ico ico-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5l11 7-11 7z"/></svg>
      </button>
    </div>
    <figure class="frase" aria-label="Frase motivadora" aria-live="polite" aria-atomic="true">
      <blockquote><p id="frase-texto">{{ f.texto }}</p></blockquote>
      <figcaption id="frase-autor"{% if not f.autor %} hidden{% endif %}>{{ f.autor }}</figcaption>
      <button type="button" class="frase-otra" id="frase-otra" hidden
              aria-label="Mostrar otra frase" title="Otra frase">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11a8 8 0 0 0-14.5-4.4M4 4v4h4M4 13a8 8 0 0 0 14.5 4.4M20 20v-4h-4"/></svg>
      </button>
    </figure>
  </div>
</div>
{% endblock %}

{% block main %}
  <main class="wrap" id="contenido" tabindex="-1">
    {% if destacados %}
    <section class="destacados">
      <h2 class="cat-h" id="h-destacados">
        <button type="button" class="cat-header" id="b-destacados" aria-expanded="true" aria-controls="p-destacados">
          <span class="cat-titulo"><span aria-hidden="true">🔥</span> Lo más comentado</span>
          <span class="cat-count"><span class="sr-only">, </span>cubierto por {{ destacados_cobertura_minima }}+ fuentes</span>
        </button>
      </h2>
      <div class="cat-body abierto" id="p-destacados">
        <div class="cat-grid">
          {% for item in destacados %}{{ m.render_item(item, csrf_token, 'd-') }}{% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    <section class="todas">
      <h2 class="cat-h" id="h-todas">
        <button type="button" class="cat-header" id="b-todas" aria-expanded="true" aria-controls="p-todas">
          <span class="cat-titulo">{% if q %}Resultados para «{{ q }}»{% else %}Todas las noticias{% endif %}</span>
          <span class="cat-count"><span class="sr-only">, </span>{{ total_items }}<span class="sr-only"> noticias</span></span>
        </button>
      </h2>
      <div class="cat-body abierto" id="p-todas">
        <div class="cat-grid">
          {% if noticias %}
            {% for item in noticias %}{{ m.render_item(item, csrf_token) }}{% endfor %}
          {% else %}
            <p class="vacio">{% if q %}Ninguna noticia coincide con «{{ q }}» en este rango y categorías. Prueba con otra palabra o amplía los días.{% else %}No hay noticias en este rango de días con las categorías elegidas.{% endif %}</p>
          {% endif %}
        </div>
      </div>
    </section>

    {% if total_paginas > 1 %}
    <nav class="paginacion" aria-label="Paginación de resultados">
      {% if pagina > 1 %}
        <a href="?dias={{ dias }}{{ categorias_qs }}&pagina={{ pagina - 1 }}" rel="prev"><span aria-hidden="true">←</span> Anterior</a>
      {% else %}
        <span class="paginacion-deshabilitado" aria-hidden="true">← Anterior</span>
      {% endif %}

      <span class="paginacion-estado" aria-current="page">Página {{ pagina }} de {{ total_paginas }}</span>

      {% if pagina < total_paginas %}
        <a href="?dias={{ dias }}{{ categorias_qs }}&pagina={{ pagina + 1 }}" rel="next">Siguiente <span aria-hidden="true">→</span></a>
      {% else %}
        <span class="paginacion-deshabilitado" aria-hidden="true">Siguiente →</span>
      {% endif %}
    </nav>
    {% endif %}
  </main>
{% endblock %}

{% block cuerpo_extra %}
  <script nonce="{{ request.state.csp_nonce }}">
    /* Secciones plegables: botón dentro de un encabezado h2 (aria-expanded +
       aria-controls). Se abren y cierran con una animación de altura y las
       tarjetas entran en cascada; recuerda lo abierto durante la sesión, abre la
       sección que contenga el ancla de la URL y se revela con Ctrl+F
       (hidden="until-found"). Sin JavaScript las secciones se muestran abiertas. */
    (function () {
      var K = "pingunews-secciones", guardado = {};
      try { guardado = JSON.parse(sessionStorage.getItem(K) || "{}"); } catch (e) {}
      var reducir = window.matchMedia("(prefers-reduced-motion: reduce)");
      var oculto = ("onbeforematch" in document.body) ? "until-found" : "";
      function recuerda(id, abierto) {
        guardado[id] = abierto;
        try { sessionStorage.setItem(K, JSON.stringify(guardado)); } catch (e) {}
      }
      function abrir(boton, panel, animar) {
        clearTimeout(panel._t);
        boton.setAttribute("aria-expanded", "true");
        panel.removeAttribute("hidden"); panel.removeAttribute("inert");
        if (animar && !reducir.matches) {
          panel.classList.add("anima");
          void panel.offsetHeight;                      /* fija el estado "cerrado" antes de animar */
          panel.classList.add("abierto");
          panel._t = setTimeout(function () { panel.classList.remove("anima"); }, 1100);
        } else {
          panel.classList.add("abierto");
        }
      }
      function cerrar(boton, panel, animar) {
        clearTimeout(panel._t);
        boton.setAttribute("aria-expanded", "false");
        panel.setAttribute("inert", "");
        panel.classList.remove("anima", "abierto");
        if (animar && !reducir.matches) {
          panel._t = setTimeout(function () { if (!panel.classList.contains("abierto")) panel.setAttribute("hidden", oculto); }, 560);
        } else {
          panel.setAttribute("hidden", oculto);
        }
      }
      document.querySelectorAll("button.cat-header").forEach(function (boton) {
        var panel = document.getElementById(boton.getAttribute("aria-controls"));
        var ahora = boton.getAttribute("aria-expanded") === "true";
        var deseado = typeof guardado[boton.id] === "boolean" ? guardado[boton.id] : ahora;
        if (deseado !== ahora) (deseado ? abrir : cerrar)(boton, panel, false);
        else if (!deseado) panel.setAttribute("hidden", oculto);
        boton.addEventListener("click", function () {
          var abrirAhora = boton.getAttribute("aria-expanded") !== "true";
          (abrirAhora ? abrir : cerrar)(boton, panel, true);
          recuerda(boton.id, abrirAhora);
        });
        panel.addEventListener("beforematch", function () { abrir(boton, panel, false); recuerda(boton.id, true); });
      });
      if (location.hash.length > 1) {
        var destino = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        var panelDestino = destino && destino.closest(".cat-body");
        if (panelDestino && !panelDestino.classList.contains("abierto")) {
          var b = document.querySelector('[aria-controls="' + panelDestino.id + '"]');
          if (b) { abrir(b, panelDestino, false); destino.scrollIntoView(); }
        }
      }
    })();
  </script>
  <script src="/static/panel.js?v={{ static_v('panel.js') }}" defer></script>

  <!-- Pantalla completa mostrada mientras "↻ Actualizar ahora" recopila
       noticias nuevas (petición normal al servidor, sin AJAX: el envío del
       formulario sigue su curso y esta capa solo se ve encima mientras la
       página espera la respuesta). Oculta por defecto; panel.js la muestra. -->
  <div class="overlay-actualizando" id="overlay-actualizando" hidden>
    <div class="overlay-actualizando-caja" role="status" aria-live="assertive">
      <div class="overlay-pingu-caja">
        {{ m.pingu(190, 'vivo a-investiga') }}
        <svg class="overlay-lupa" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <circle cx="26" cy="26" r="16" fill="var(--bg-card)" opacity=".6"/>
          <circle cx="26" cy="26" r="16" fill="none" stroke="var(--accent)" stroke-width="5"/>
          <ellipse cx="20" cy="19" rx="5" ry="3" fill="#fff" opacity=".55" transform="rotate(-30 20 19)"/>
          <line x1="38" y1="38" x2="56" y2="56" stroke="var(--accent)" stroke-width="6" stroke-linecap="round"/>
        </svg>
      </div>
      <p class="overlay-titulo">Buscando noticias nuevas<span class="overlay-puntos" aria-hidden="true"></span></p>
      <p class="overlay-subtitulo">Repasando ciberseguridad, empleo e IT en todas las fuentes…</p>
      <div class="overlay-barra" aria-hidden="true"><span></span></div>
    </div>
  </div>
{% endblock %}
