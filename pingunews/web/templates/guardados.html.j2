{% extends "_base.html.j2" %}
{% block titulo %}Mis guardados — PinguNews{% endblock %}
{% block titulo_pagina %}🔖 Mis guardados{% endblock %}
{% block subtitulo_pagina %}<span class="subtitulo">ítems que has guardado para ver más tarde</span>{% endblock %}

{% block main %}
  <main class="wrap" id="contenido" tabindex="-1">
    {% if items %}
      <div class="cat-grid">
        {% for item in items %}{{ m.render_item(item, csrf_token) }}{% endfor %}
      </div>
    {% else %}
      <p class="vacio">Todavía no has guardado ningún ítem. Pulsa "📑 Guardar" en cualquier noticia del panel para que aparezca aquí.</p>
    {% endif %}
  </main>
{% endblock %}

{% block cuerpo_extra %}<script src="/static/panel.js?v={{ static_v('panel.js') }}" defer></script>{% endblock %}
