{% extends "_auth_base.html.j2" %}
{% block titulo %}Restablecer contraseña — PinguNews{% endblock %}

{% block auth_card %}
<p class="auth-marca">PinguNews</p>
<h1>Elige una contraseña nueva</h1>
<p class="auth-sub">Esta contraseña sustituirá a la anterior en toda tu cuenta.</p>

{% if error %}<p class="auth-error" id="auth-error" role="alert"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.4v.1"/></svg><span>{{ error }}</span></p>{% endif %}

<form method="post" action="/restablecer-password">
  <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
  <input type="hidden" name="token" value="{{ token }}">
  <div class="campo">
    <label for="password">Contraseña nueva</label>
    <div class="campo-caja">
      <svg class="campo-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
      <input type="password" id="password" name="password" data-pw aria-describedby="password-ayuda{% if error %} auth-error{% endif %}" autocomplete="new-password" minlength="8" required>
      <button type="button" class="btn-ojo" data-for="password" data-nombre="contraseña" hidden aria-pressed="false" aria-label="Mostrar contraseña"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button>
    </div>
    <p class="campo-ayuda" id="password-ayuda">Mínimo 8 caracteres.</p>
  </div>
  <div class="campo">
    <label for="password2">Repite la contraseña</label>
    <div class="campo-caja">
      <svg class="campo-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
      <input type="password" id="password2" name="password2" data-pw autocomplete="new-password" minlength="8" required{% if error %} aria-describedby="auth-error"{% endif %}>
      <button type="button" class="btn-ojo" data-for="password2" data-nombre="contraseña repetida" hidden aria-pressed="false" aria-label="Mostrar contraseña repetida"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button>
    </div>
  </div>
  <button type="submit" class="btn btn-primario btn-grande">Guardar contraseña nueva</button>
</form>
{% endblock %}
