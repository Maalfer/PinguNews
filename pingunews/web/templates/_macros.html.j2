                  <linearGradient id="gBarriga" gradientUnits="userSpaceOnUse" x1="100" y1="120" x2="100" y2="229">
                    <stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#f0e6d6"/>
