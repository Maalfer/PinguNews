                        <ellipse cx="96" cy="90" rx="2.4" ry="1.5" fill="#fff" opacity=".5"/>
                      </g>
                    </g>
                    <!-- aletitas -->
                    <g class="p-fl-i">
                      <path fill="url(#gAleta)" d="M40 114 C20 124 12 150 22 170 C28 180 40 174 46 164 C54 150 56 130 52 118 Z"/>
                      <path d="M44 124 C32 134 27 150 30 163" fill="none" stroke="#fff" stroke-opacity=".32" stroke-width="2.4" stroke-linecap="round"/>
                    </g>
                    <g class="p-fl-d">
                      <path fill="url(#gAleta)" d="M160 114 C180 124 188 150 178 170 C172 180 160 174 154 164 C146 150 144 130 148 118 Z"/>
                      <path d="M156 124 C168 134 173 150 170 163" fill="none" stroke="#fff" stroke-opacity=".32" stroke-width="2.4" stroke-linecap="round"/>
                    </g>
                  </g>
                </g>

                <!-- efectos -->
                <g transform="translate(84 18)"><path class="p-corazon c1" d="M0 -2 C-3 -8 -11 -5 -7 1 L0 9 L7 1 C11 -5 3 -8 0 -2 Z"/></g>
                <g transform="translate(100 8)"><path class="p-corazon c2" d="M0 -2 C-3 -8 -11 -5 -7 1 L0 9 L7 1 C11 -5 3 -8 0 -2 Z"/></g>
                <g transform="translate(118 20)"><path class="p-corazon c3" d="M0 -2 C-3 -8 -11 -5 -7 1 L0 9 L7 1 C11 -5 3 -8 0 -2 Z"/></g>
                <text class="p-nota n1" x="150" y="46">&#9834;</text>
                <text class="p-nota n2" x="34" y="36">&#9835;</text>
                <text class="p-zzz z1" x="146" y="44">z</text>
