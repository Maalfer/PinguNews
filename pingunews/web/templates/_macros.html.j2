                      <circle cx="111" cy="240" r="5.2" fill="url(#gPie)"/><circle cx="124" cy="242" r="5.2" fill="url(#gPie)"/><circle cx="137" cy="240" r="5.2" fill="url(#gPie)"/>
                      <path d="M117.5 241 L117.5 244.5 M130.5 241 L130.5 244.5" stroke="#d9741a" stroke-width="1.2" stroke-linecap="round" opacity=".6"/>
                    </g>
                  </g>

                  <g class="p-respira">
                    <!-- cuerpo redondito, con luz y sombra suaves -->
                    <path fill="url(#gCuerpo)" d="M100 22 C146 22 168 58 166 98 C178 120 172 188 152 214 C140 232 120 238 100 238 C80 238 60 232 48 214 C28 188 22 120 34 98 C32 58 54 22 100 22 Z"/>
                    <path fill="url(#gSombraCuerpo)" d="M100 22 C146 22 168 58 166 98 C178 120 172 188 152 214 C140 232 120 238 100 238 C80 238 60 232 48 214 C28 188 22 120 34 98 C32 58 54 22 100 22 Z"/>
                    <path fill="none" stroke="url(#gBorde)" stroke-width="2.4" d="M100 22 C146 22 168 58 166 98 C178 120 172 188 152 214 C140 232 120 238 100 238 C80 238 60 232 48 214 C28 188 22 120 34 98 C32 58 54 22 100 22 Z"/>
                    <ellipse cx="100" cy="38" rx="32" ry="11" fill="#fff" opacity=".13"/>
                    <!-- barriguita -->
                    <path fill="url(#gBarriga)" d="M100 120 C134 120 152 152 150 188 C148 216 128 229 100 229 C72 229 52 216 50 188 C48 152 66 120 100 120 Z"/>
                    <path fill="url(#gBarrigaSombra)" d="M100 120 C134 120 152 152 150 188 C148 216 128 229 100 229 C72 229 52 216 50 188 C48 152 66 120 100 120 Z"/>

                    <!-- cabeza: carita en forma de corazón -->
                    <g class="p-cabeza">
                      <path class="p-mechon" fill="url(#gCuerpo)" d="M90 25 Q86 10 95 16 Q99 3 103 16 Q112 8 110 25 Z"/>
                      <path fill="#fffaf2" d="M100 114 C68 114 44 98 44 78 C44 60 62 54 77 58 C88 61 95 67 100 73 C105 67 112 61 123 58 C138 54 156 60 156 78 C156 98 132 114 100 114 Z"/>
                      <circle cx="58" cy="100" r="11" fill="url(#gMejilla)"/>
                      <circle cx="142" cy="100" r="11" fill="url(#gMejilla)"/>

                      <g class="p-ojos">
                        <g class="p-mirada"><g class="p-pupila">
                          <circle cx="77" cy="84" r="11.5" fill="url(#gOjo)"/>
                          <circle cx="80.6" cy="79.6" r="4.2" fill="#fff"/><circle cx="73.4" cy="89" r="1.9" fill="#fff" opacity=".85"/>
                          <circle cx="123" cy="84" r="11.5" fill="url(#gOjo)"/>
                          <circle cx="126.6" cy="79.6" r="4.2" fill="#fff"/><circle cx="119.4" cy="89" r="1.9" fill="#fff" opacity=".85"/>
                        </g></g>
                        <g class="p-parpados">
                          <ellipse cx="77" cy="84" rx="12.6" ry="12.6" fill="#fffaf2"/>
                          <ellipse cx="123" cy="84" rx="12.6" ry="12.6" fill="#fffaf2"/>
                          <path d="M66 87 Q77 96 88 87 M112 87 Q123 96 134 87" fill="none" stroke="#1b2336" stroke-width="2.6" stroke-linecap="round"/>
                        </g>
                      </g>

                      <!-- cejitas (solo se ven en algunos gestos) -->
                      <g class="p-cejas" fill="none" stroke="#1b2336" stroke-width="2.6" stroke-linecap="round">
                        <path class="p-ceja-i" d="M66 68 Q77 62 88 67"/>
                        <path class="p-ceja-d" d="M112 67 Q123 62 134 68"/>
                      </g>

                      <!-- piquito -->
                      <g class="p-pico">
                        <ellipse class="p-boca" cx="100" cy="99" rx="8.5" ry="8.5" fill="#b83a52"/>
                        <ellipse class="p-boca" cx="100" cy="104" rx="5" ry="3.6" fill="#ff8aa0"/>
