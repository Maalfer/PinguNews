<style>
  :root {
    --bg: #f4f4f5;
    --bg-card: #ffffff;
    --border: #d4d4d8;
    --text: #18181b;
    --text-muted: #52525b;
    --text-faint: #a1a1aa;
    --accent: #18181b;
    --accent-text: #fafafa;
    --focus-ring: #18181b;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    --dot-1: #18181b;
    --dot-2: #52525b;
    --dot-3: #71717a;
    --dot-4: #a1a1aa;
    --dot-5: #d4d4d8;
    --like-activo: #b91c1c;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #09090b; --bg-card: #18181b; --border: #3f3f46;
      --text: #f4f4f5; --text-muted: #d4d4d8; --text-faint: #71717a;
      --accent: #f4f4f5; --accent-text: #18181b; --focus-ring: #f4f4f5;
      --shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
      --dot-1: #f4f4f5; --dot-2: #d4d4d8; --dot-3: #a1a1aa; --dot-4: #71717a; --dot-5: #52525b;
      --like-activo: #f87171;
    }
  }
  :root[data-theme="dark"] {
    --bg: #09090b; --bg-card: #18181b; --border: #3f3f46;
    --text: #f4f4f5; --text-muted: #d4d4d8; --text-faint: #71717a;
    --accent: #f4f4f5; --accent-text: #18181b; --focus-ring: #f4f4f5;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    --dot-1: #f4f4f5; --dot-2: #d4d4d8; --dot-3: #a1a1aa; --dot-4: #71717a; --dot-5: #52525b;
    --like-activo: #f87171;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  body {
    margin: 0; padding: 0; background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
    overflow-x: hidden;
  }
  a { color: inherit; }
  img { max-width: 100%; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 clamp(16px, 3vw, 32px) 40px; }

  /* Visible para todos: foco de teclado siempre claro */
  a:focus-visible, button:focus-visible, input:focus-visible, label:focus-within {
    outline: 3px solid var(--focus-ring); outline-offset: 2px; border-radius: 4px;
    box-shadow: 0 0 0 5px var(--bg-card);
  }
  summary:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 2px; }

  /* Enlace para saltar al contenido (teclado / lector de pantalla) */
  .skip-link {
    position: absolute; left: 8px; top: -64px; z-index: 100; background: var(--accent); color: var(--accent-text);
    padding: 12px 18px; border-radius: 8px; font-weight: 700; text-decoration: none;
  }
  .skip-link:focus { top: 8px; }
  main:focus { outline: none; }
  html { scroll-padding-top: 16px; }

  /* ---- Header ---- */
  header.top { background: var(--bg-card); border-bottom: 1px solid var(--border); margin-bottom: 24px; width: 100%; }
  header.top .inner { width: 100%; max-width: none; margin: 0; padding: 16px clamp(16px, 3vw, 48px) 16px; }
  .brand-fila { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .brand h1 { font-size: 1.3rem; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
  .brand .subtitulo { color: var(--text-muted); font-size: 0.85rem; }
  .estado { margin: 6px 0 0; color: var(--text-muted); font-size: 0.875rem; }
  .logo { width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0; display: block; }
  .auth-logo { display: flex; justify-content: center; margin-bottom: 14px; }
  .auth-logo img { width: 72px; height: 72px; border-radius: 16px; }

  /* ---- Área de autenticación (esquina del header) ---- */
  .auth-area { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.875rem; }
  .auth-area .form-salir { margin: 0; }
  .usuario { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--text); margin-right: 4px; }
  .avatar {
    width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: var(--accent-text);
    display: inline-flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700;
    flex-shrink: 0;
  }
  .btn-ghost, .btn-solid {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    min-height: 40px; padding: 0 16px; border-radius: 999px; font: inherit; font-size: 0.875rem;
    font-weight: 500; text-decoration: none; cursor: pointer; white-space: nowrap;
    border: 1px solid var(--border); background: transparent; color: var(--text);
    transition: background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }
  .btn-ghost:hover { background: var(--bg); border-color: var(--text-muted); }
  .btn-solid { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
  .btn-solid:hover { opacity: 0.85; }
  .btn-ghost .ico {
    width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0;
  }
  @media (pointer: coarse) { .btn-ghost, .btn-solid { min-height: 44px; } }
  @media (prefers-reduced-motion: reduce) { .btn-ghost, .btn-solid { transition: none; } }
  @media (forced-colors: active) { .btn-ghost, .btn-solid { border: 1px solid ButtonText; } }
  .btn-enlace {
    background: none; border: none; padding: 0 4px; margin: 0; font: inherit; min-height: 44px;
    color: var(--text-muted); text-decoration: underline; cursor: pointer;
  }
  .btn-enlace:hover { color: var(--text); }

  /* ---- Barra de controles: dos bloques agrupados y etiquetados ---- */
  .panel-controles {
    margin-top: 14px; border: 1px solid var(--border); border-radius: 12px;
    background: var(--bg);
  }
  .grupo-control { padding: 14px 16px; }
  .grupo-control + .grupo-control { border-top: 1px solid var(--border); }
  .grupo-control-titulo {
    display: block; font-size: 0.75rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.04em; color: var(--text-muted); margin-bottom: 10px;
  }
  /* Reset de los estilos nativos del navegador para fieldset/legend: solo se
     usan por semántica/accesibilidad (agrupan los checkboxes para lectores
     de pantalla), el aspecto visual lo da .grupo-control / .grupo-control-titulo */
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend.grupo-control-titulo { padding: 0; }

  /* Oculto visualmente pero disponible para lectores de pantalla (nunca
     display:none, que también lo saca del foco de teclado) */
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* ---- Categorías como panel plegable (<details>/<summary> nativos:
     accesibles por teclado y lector de pantalla sin JavaScript) ---- */
  details.grupo-control-plegable summary.grupo-control-titulo,
  .grupo-control--plegable > summary.grupo-control-titulo {
    cursor: pointer; display: flex; align-items: center; gap: 6px;
    list-style: none; user-select: none; margin-bottom: 0;
  }
  .grupo-control--plegable > summary::-webkit-details-marker { display: none; }
  .grupo-control--plegable > summary::marker { content: ""; }
  .grupo-control--plegable > summary::after {
    content: "▾"; margin-left: auto; color: var(--text-muted); font-size: 0.9em;
    transition: transform 0.15s ease;
  }
  .grupo-control--plegable[open] > summary::after { transform: rotate(180deg); }
  .grupo-control--plegable > summary:focus-visible {
    outline: 2px solid var(--focus-ring); outline-offset: 2px; border-radius: 4px;
  }
  .resumen-seleccion { text-transform: none; font-weight: 400; letter-spacing: normal; color: var(--text-muted); }
  .contenido-plegable { margin-top: 14px; }

  .fila-rango { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; }
  nav.dias-selector ul {
    list-style: none; display: flex; flex-wrap: wrap; gap: 4px; margin: 0; padding: 3px;
    background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px;
  }
  nav.dias-selector li { margin: 0; }
  nav.dias-selector a {
    text-decoration: none; font-size: 0.875rem; color: var(--text-muted);
    border-radius: 6px; padding: 10px 12px; font-weight: 500; min-width: 44px; min-height: 44px; display: flex; align-items: center; justify-content: center;
  }
  nav.dias-selector a[aria-current="page"] { background: var(--accent); color: var(--accent-text); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  nav.dias-selector a:hover:not([aria-current="page"]) { background: var(--border); }

  .btn {
    font-size: 0.9rem; border: 1px solid var(--border); border-radius: 8px; padding: 8px 16px;
    background: var(--bg-card); color: var(--text); cursor: pointer; font-weight: 500;
    min-height: 44px;
  }
  .btn:hover { background: var(--border); }
  .btn-primario { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
  .btn-primario:hover { opacity: 0.85; }

  .lista-categorias {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .lista-categorias li { margin: 0; }
  .chip {
    font-size: 0.875rem; border: 1px solid var(--border); border-radius: 999px;
    padding: 6px 14px 6px 10px; cursor: pointer; background: var(--bg-card); color: var(--text-muted);
    user-select: none; display: inline-flex; align-items: center; gap: 7px; min-height: 44px;
  }
  .chip:has(input:checked) { background: var(--bg-card); color: var(--text); border-color: var(--text); box-shadow: inset 0 0 0 1px var(--text); font-weight: 600; }
  .chip input { width: 18px; height: 18px; accent-color: var(--text); cursor: pointer; flex-shrink: 0; }
  .chip:has(input:checked) input { accent-color: var(--text); }

  .fila-aplicar { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .fila-categorias { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  .fila-categorias .lista-categorias { flex: 1 1 auto; }
  .chip-n {
    font-variant-numeric: tabular-nums; font-size: 0.78rem; font-weight: 700; min-width: 1.9em;
    text-align: center; padding: 1px 7px; border-radius: 999px; background: var(--bg);
    color: var(--text); border: 1px solid var(--border);
  }
  .chip:has(input:checked) .chip-n { background: var(--text); color: var(--bg); border-color: var(--text); }
  /* legend como bloque: evita el comportamiento especial del legend nativo */
  fieldset { display: flow-root; }
  legend.grupo-control-titulo { width: 100%; margin-bottom: 10px; }
  /* Coherencia visual: todo en forma de píldora */
  .btn { border-radius: 999px; }
  nav.dias-selector ul { border-radius: 999px; }
  nav.dias-selector a { border-radius: 999px; }
  /* ---- Desplegable de categorías ---- */
  details.dropdown { position: relative; }
  summary.dropdown-btn { list-style: none; user-select: none; padding-right: 12px; }
  summary.dropdown-btn::-webkit-details-marker { display: none; }
  summary.dropdown-btn::marker { content: ""; }
  summary.dropdown-btn::after {
    content: ""; width: 7px; height: 7px; margin: -3px 2px 0 6px;
    border-right: 1.8px solid currentColor; border-bottom: 1.8px solid currentColor;
    transform: rotate(45deg); transition: transform 0.15s ease;
  }
  details.dropdown[open] > summary.dropdown-btn { border-color: var(--text); background: var(--bg); }
  details.dropdown[open] > summary.dropdown-btn::after { transform: rotate(-135deg); margin-top: 3px; }
  .dropdown-panel {
    margin-top: 8px; padding: 16px; background: var(--bg-card);
    border: 1px solid var(--border); border-radius: 14px;
  }
  .dropdown-panel .grupo-control-titulo { margin-bottom: 12px; }
  @media (prefers-reduced-motion: reduce) { summary.dropdown-btn::after { transition: none; } }

  /* ---- Pingüino mascota (botón interactivo con SVG) ---- */
  :root { --pingu-sombra: rgba(0, 0, 0, 0.16); }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --pingu-sombra: rgba(255, 255, 255, 0.10); }
  }
  :root[data-theme="dark"] { --pingu-sombra: rgba(255, 255, 255, 0.10); }

  .grupo-frase { display: flex; align-items: center; justify-content: center; gap: 18px; }
  .mascota {
    flex: 0 0 auto; width: 124px; padding: 0; margin: 0; border: 0; background: none;
    color: inherit; font: inherit; line-height: 0; cursor: pointer; border-radius: 22px;
    -webkit-tap-highlight-color: transparent;
  }
  .pingu { display: block; width: 100%; height: auto; overflow: visible; --ox: 0px; --oy: 0px; }
  .p-sombra { fill: var(--pingu-sombra); transform-origin: 100px 241px; }
  .p-cuerpo { stroke: rgba(148, 163, 184, 0.30); stroke-width: 1.2; }
  .p-aleta { fill: #111827; stroke: rgba(148, 163, 184, 0.35); stroke-width: 1.2; }
  .p-todo { transform-origin: 100px 238px; transition: transform 0.25s ease; }
  .mascota:hover .p-todo { transform: rotate(-2.5deg); }
  .p-respira { transform-origin: 100px 238px; }
  .p-fl-i { transform-origin: 50px 116px; }
  .p-fl-d { transform-origin: 150px 116px; }
  .p-cabeza { transform-origin: 100px 100px; }
  .p-ojos { transform-origin: 100px 62px; }
  .p-parpadeo { transform-origin: 100px 62px; }
  .p-pico-b { transform-origin: 100px 92px; }
  .p-pupila { transform: translate(var(--ox), var(--oy)); transition: transform 0.12s ease-out; }
  .p-corazon { opacity: 0; fill: #f43f5e; transform-box: fill-box; transform-origin: center; }
  .p-nota { opacity: 0; fill: var(--text); font: 700 22px Georgia, "Times New Roman", serif; }

  /* ----- reposo: respira, parpadea y saluda al entrar (finito, ~25 s) ----- */
  .pingu.idle .p-respira { animation: k-respira 3.2s ease-in-out 8; }
  .pingu.idle .p-parpadeo { animation: k-parpadea 4.5s ease-in-out 6; }
  .pingu.hola .p-fl-d { animation: k-saludo 2.2s ease-in-out 0.8s 1; }
  @keyframes k-respira { 0%, 100% { transform: translateY(0) scale(1, 1); } 50% { transform: translateY(-1.5px) scale(1.012, 1.014); } }
  @keyframes k-parpadea { 0%, 90%, 100% { transform: scaleY(1); } 94% { transform: scaleY(0.08); } }
  @keyframes k-saludo {
    0%, 100% { transform: rotate(0); }
    12%, 40%, 68% { transform: rotate(-80deg); }
    26%, 54%, 82% { transform: rotate(-52deg); }
    93% { transform: rotate(0); }
  }

  /* ----- reacciones al clic ----- */
  /* salto con aplastamiento y estiramiento */
  .pingu.a-salto .p-todo { animation: k-salto 1.1s cubic-bezier(0.3, 0.1, 0.3, 1); }
  .pingu.a-salto .p-sombra { animation: k-salto-sombra 1.1s ease-in-out; }
  .pingu.a-salto .p-fl-d { animation: k-fl-d-arriba 1.1s ease-in-out; }
  .pingu.a-salto .p-fl-i { animation: k-fl-i-arriba 1.1s ease-in-out; }
  @keyframes k-salto {
    0% { transform: translateY(0) scale(1, 1); } 14% { transform: translateY(0) scale(1.1, 0.88); }
    38%, 58% { transform: translateY(-54px) scale(0.95, 1.07); } 80% { transform: translateY(0) scale(1.12, 0.86); }
    90% { transform: translateY(0) scale(0.97, 1.04); } 100% { transform: translateY(0) scale(1, 1); }
  }
  @keyframes k-salto-sombra { 0%, 14%, 80%, 100% { transform: scale(1); opacity: 1; } 38%, 58% { transform: scale(0.6); opacity: 0.5; } }
  @keyframes k-fl-d-arriba { 0%, 14%, 80%, 100% { transform: rotate(0); } 38%, 58% { transform: rotate(-68deg); } }
  @keyframes k-fl-i-arriba { 0%, 14%, 80%, 100% { transform: rotate(0); } 38%, 58% { transform: rotate(68deg); } }

  /* pirueta: dos vueltas (se "estrecha" al girar) con saltito */
  .pingu.a-giro .p-todo { animation: k-giro 1.5s ease-in-out; }
  .pingu.a-giro .p-fl-d { animation: k-fl-d-medio 1.5s ease-in-out; }
  .pingu.a-giro .p-fl-i { animation: k-fl-i-medio 1.5s ease-in-out; }
  @keyframes k-giro {
    0% { transform: translateY(0) scaleX(1); } 12.5% { transform: translateY(-12px) scaleX(0.05); }
    25% { transform: translateY(-22px) scaleX(-1); } 37.5% { transform: translateY(-26px) scaleX(0.05); }
    50% { transform: translateY(-26px) scaleX(1); } 62.5% { transform: translateY(-22px) scaleX(0.05); }
    75% { transform: translateY(-12px) scaleX(-1); } 87.5% { transform: translateY(-3px) scaleX(0.05); }
    100% { transform: translateY(0) scaleX(1); }
  }
  @keyframes k-fl-d-medio { 0%, 100% { transform: rotate(0); } 15%, 85% { transform: rotate(-38deg); } }
  @keyframes k-fl-i-medio { 0%, 100% { transform: rotate(0); } 15%, 85% { transform: rotate(38deg); } }

  /* baile: se balancea con las aletas alternas y salen notas */
  .pingu.a-baile .p-todo { animation: k-baile 1.9s ease-in-out; }
  .pingu.a-baile .p-cabeza { animation: k-cabecea 0.475s ease-in-out 4; }
  .pingu.a-baile .p-fl-d { animation: k-fl-d-baile 1.9s ease-in-out; }
  .pingu.a-baile .p-fl-i { animation: k-fl-i-baile 1.9s ease-in-out; }
  .pingu.a-baile .p-nota.n1 { animation: k-nota 1.9s ease-out 0.1s; }
  .pingu.a-baile .p-nota.n2 { animation: k-nota 1.9s ease-out 0.7s; }
  @keyframes k-baile {
    0%, 100% { transform: translateY(0) rotate(0); } 12.5% { transform: translateY(-9px) rotate(-9deg); }
    25% { transform: translateY(0) rotate(0); } 37.5% { transform: translateY(-9px) rotate(9deg); }
    50% { transform: translateY(0) rotate(0); } 62.5% { transform: translateY(-9px) rotate(-9deg); }
    75% { transform: translateY(0) rotate(0); } 87.5% { transform: translateY(-9px) rotate(9deg); }
  }
  @keyframes k-cabecea { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(5deg); } }
  @keyframes k-fl-d-baile { 0%, 50%, 100% { transform: rotate(-12deg); } 25%, 75% { transform: rotate(-62deg); } }
  @keyframes k-fl-i-baile { 0%, 50%, 100% { transform: rotate(62deg); } 25%, 75% { transform: rotate(12deg); } }
  @keyframes k-nota { 0% { opacity: 0; transform: translateY(14px); } 20%, 60% { opacity: 1; } 100% { opacity: 0; transform: translateY(-24px); } }

  /* saludo con la aleta y ligera inclinación */
  .pingu.a-saludo .p-fl-d { animation: k-saludo 2.1s ease-in-out; }
  .pingu.a-saludo .p-todo { animation: k-inclina 2.1s ease-in-out; }
  .pingu.a-saludo .p-parpadeo { animation: k-parpadea-fuerte 2.1s ease-in-out; }
  @keyframes k-inclina { 0%, 100% { transform: rotate(0); } 15%, 85% { transform: rotate(-4deg); } }
  @keyframes k-parpadea-fuerte { 0%, 55%, 100% { transform: scaleY(1); } 62% { transform: scaleY(0.1); } 70% { transform: scaleY(1); } }

  /* aleteo: bate las dos aletas y se eleva un poco */
  .pingu.a-aleteo .p-todo { animation: k-aleteo 1.5s ease-in-out; }
  .pingu.a-aleteo .p-sombra { animation: k-salto-sombra 1.5s ease-in-out; }
  .pingu.a-aleteo .p-fl-d { animation: k-fl-d-aleteo 1.5s ease-in-out; }
  .pingu.a-aleteo .p-fl-i { animation: k-fl-i-aleteo 1.5s ease-in-out; }
  @keyframes k-aleteo {
    0%, 100% { transform: translateY(0); } 15%, 85% { transform: translateY(-16px) rotate(0); }
    30% { transform: translateY(-18px) rotate(-2deg); } 50% { transform: translateY(-14px) rotate(2deg); } 70% { transform: translateY(-18px) rotate(-2deg); }
  }
  @keyframes k-fl-d-aleteo {
    0%, 100% { transform: rotate(-4deg); } 10%, 30%, 50%, 70%, 90% { transform: rotate(-74deg); }
    20%, 40%, 60%, 80% { transform: rotate(-22deg); }
  }
  @keyframes k-fl-i-aleteo {
    0%, 100% { transform: rotate(4deg); } 10%, 30%, 50%, 70%, 90% { transform: rotate(74deg); }
    20%, 40%, 60%, 80% { transform: rotate(22deg); }
  }

  /* sorpresa: ojos enormes, pico abierto y salto hacia atrás */
  .pingu.a-sorpresa .p-todo { animation: k-sorpresa 1.5s ease-out; }
  .pingu.a-sorpresa .p-ojos { animation: k-ojos-grandes 1.5s ease-out; }
  .pingu.a-sorpresa .p-pico-b { animation: k-pico-abre 1.5s ease-out; }
  .pingu.a-sorpresa .p-fl-d { animation: k-fl-d-medio 1.5s ease-out; }
  .pingu.a-sorpresa .p-fl-i { animation: k-fl-i-medio 1.5s ease-out; }
  @keyframes k-sorpresa {
    0% { transform: translateY(0) scale(1, 1); } 10% { transform: translateY(-16px) scale(0.95, 1.08); }
    22% { transform: translateY(0) scale(1.06, 0.94); } 32%, 80% { transform: translateY(0) scale(1, 1.03); } 100% { transform: translateY(0) scale(1, 1); }
  }
  @keyframes k-ojos-grandes { 0%, 100% { transform: scale(1); } 10%, 80% { transform: scale(1.28); } }
  @keyframes k-pico-abre { 0%, 100% { transform: translateY(0); } 10%, 80% { transform: translateY(6px); } }

  /* cosquillas: tiembla de risa con los ojos entornados */
