<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PinguNews</title>
{% include "_favicon.html.j2" %}
{% include "_estilos.html.j2" %}
<noscript><style>.cat-body[hidden]{display:block !important;content-visibility:visible !important}.cat-header{cursor:default}</style></noscript>
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  {% import "_macros.html.j2" as m %}

  <header class="top">
    <div class="inner">
      <div class="brand-fila">
        <div class="brand">
          <img class="logo" src="/static/logo.png" alt="" width="64" height="64">
          <h1>PinguNews</h1>
        </div>
        {{ m.auth_area(usuario, csrf_token) }}
      </div>
      <p class="estado">
        {% if ultima_recoleccion %}Última recolección: {{ ultima_recoleccion }}{% else %}Todavía no se ha recolectado nada — pulsa "Actualizar ahora".{% endif %}
        <span class="separador" aria-hidden="true">·</span>
        <strong>{{ total_items }}</strong> ítems en este rango
      </p>

      <div class="panel-controles">
        <div class="grupo-control grupo-rango">
          <span class="grupo-control-titulo" id="titulo-rango">Rango de fechas</span>
          <div class="fila-rango">
            <nav class="dias-selector" aria-labelledby="titulo-rango">
              <ul>
                {% for opcion in opciones_dias %}
                <li>
                  <a href="?dias={{ opcion }}{{ categorias_qs }}"{% if opcion == dias %} aria-current="page"{% endif %}>
                    {{ opcion }}d<span class="sr-only">: {{ 'último día' if opcion == 1 else 'últimos ' ~ opcion ~ ' días' }}</span>
                  </a>
                </li>
                {% endfor %}
              </ul>
            </nav>
            <form method="post" action="/actualizar?dias={{ dias }}{{ categorias_qs }}">
              <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
              <button class="btn btn-primario" type="submit"><span aria-hidden="true">↻</span> Actualizar ahora</button>
            </form>
          </div>
        </div>

        <div class="grupo-control grupo-categorias">
          <span class="grupo-control-titulo" id="titulo-cats">Categorías</span>
          <details class="dropdown">
            <summary class="btn-ghost dropdown-btn" aria-describedby="titulo-cats">
              {{ categorias_activas | length }} de {{ categorias_disponibles | length }} seleccionadas
            </summary>
            <div class="dropdown-panel">
              <form method="get" action="/">
                <fieldset>
                  <legend class="grupo-control-titulo">Elige qué categorías mostrar</legend>
                  <input type="hidden" name="dias" value="{{ dias }}">
                  <div class="fila-categorias">
                    <ul class="lista-categorias">
                      {% for cat, label in categorias_disponibles %}
                      <li>
                        <label class="chip" title="{{ label }}">
                          <input type="checkbox" name="categorias" value="{{ cat }}" {{ 'checked' if cat in categorias_activas else '' }}>
                          <span class="chip-txt">{{ label.split(' (')[0] | emoji_decorativo }}</span>
                          <span class="chip-n">{{ conteo_por_categoria.get(cat, 0) }}</span>
                        </label>
                      </li>
                      {% endfor %}
                    </ul>
                    <div class="fila-aplicar">
                      <button class="btn btn-primario" type="submit">Aplicar</button>
                      <a class="btn-ghost" href="/?dias={{ dias }}">Ver todas</a>
                    </div>
                  </div>
                </fieldset>
              </form>
            </div>
          </details>
        </div>

        {% set f = frase_aleatoria() %}
        <div class="grupo-control grupo-frase">
          <div class="mascota-caja">
            <button type="button" class="mascota" id="mascota" title="¡Haz clic!"
                    aria-label="Pingüino mascota. Púlsalo para verlo hacer una animación">
              <svg class="pingu hola" viewBox="0 0 200 250" width="140" height="175" aria-hidden="true" focusable="false">
                <defs>
                  <linearGradient id="gCuerpo" gradientUnits="userSpaceOnUse" x1="100" y1="22" x2="100" y2="238">
                    <stop class="sb0" offset="0"/><stop class="sb1" offset=".5"/><stop class="sb2" offset="1"/>
                  </linearGradient>
                  <linearGradient id="gBorde" gradientUnits="userSpaceOnUse" x1="30" y1="24" x2="150" y2="170">
                    <stop offset="0" stop-color="#fff" stop-opacity=".5"/><stop offset=".55" stop-color="#fff" stop-opacity="0"/>
                  </linearGradient>
                  <radialGradient id="gSombraCuerpo" gradientUnits="userSpaceOnUse" cx="100" cy="150" r="100">
                    <stop offset=".62" stop-color="#0b1020" stop-opacity="0"/><stop offset="1" stop-color="#0b1020" stop-opacity=".3"/>
                  </radialGradient>
                  <linearGradient id="gBarriga" gradientUnits="userSpaceOnUse" x1="100" y1="120" x2="100" y2="229">
                    <stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#f0e6d6"/>
                  </linearGradient>
                  <radialGradient id="gBarrigaSombra" gradientUnits="userSpaceOnUse" cx="100" cy="176" r="62">
                    <stop offset=".6" stop-color="#8a6f4a" stop-opacity="0"/><stop offset="1" stop-color="#8a6f4a" stop-opacity=".2"/>
                  </radialGradient>
                  <linearGradient id="gAleta" gradientUnits="userSpaceOnUse" x1="0" y1="114" x2="0" y2="180">
                    <stop class="sa0" offset="0"/><stop class="sa1" offset="1"/>
                  </linearGradient>
                  <radialGradient id="gOjo" cx=".38" cy=".32" r=".85">
                    <stop offset="0" stop-color="#34436b"/><stop offset=".55" stop-color="#1b2540"/><stop offset="1" stop-color="#0a0f1d"/>
                  </radialGradient>
                  <radialGradient id="gMejilla" cx=".5" cy=".5" r=".5">
                    <stop offset="0" stop-color="#ff7f9c" stop-opacity=".85"/><stop offset="1" stop-color="#ff9db3" stop-opacity="0"/>
                  </radialGradient>
                  <linearGradient id="gPico" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#ffc94f"/><stop offset="1" stop-color="#f5921c"/>
                  </linearGradient>
                  <linearGradient id="gPicoB" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#f7a02e"/><stop offset="1" stop-color="#e57a12"/>
                  </linearGradient>
                  <linearGradient id="gPie" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#ffc562"/><stop offset="1" stop-color="#f4861a"/>
                  </linearGradient>
                </defs>

                <ellipse class="p-sombra" cx="100" cy="241" rx="58" ry="7"/>

                <g class="p-todo">
                  <!-- piececitos -->
                  <g class="p-pies">
                    <g class="p-pie-i">
                      <ellipse cx="76" cy="236" rx="19" ry="8" fill="url(#gPie)"/>
                      <circle cx="63" cy="240" r="5.2" fill="url(#gPie)"/><circle cx="76" cy="242" r="5.2" fill="url(#gPie)"/><circle cx="89" cy="240" r="5.2" fill="url(#gPie)"/>
                      <path d="M69.5 241 L69.5 244.5 M82.5 241 L82.5 244.5" stroke="#d9741a" stroke-width="1.2" stroke-linecap="round" opacity=".6"/>
                    </g>
                    <g class="p-pie-d">
                      <ellipse cx="124" cy="236" rx="19" ry="8" fill="url(#gPie)"/>
                      <circle cx="111" cy="240" r="5.2" fill="url(#gPie)"/><circle cx="124" cy="242" r="5.2" fill="url(#gPie)"/><circle cx="137" cy="240" r="5.2" fill="url(#gPie)"/>
                      <path d="M117.5 241 L117.5 244.5 M130.5 241 L130.5 244.5" stroke="#d9741a" stroke-width="1.2" stroke-linecap="round" opacity=".6"/>
                    </g>
                  </g>

                  <g class="p-respira">
                    <!-- cuerpo redondito, con luz y sombra suaves -->
                    <path fill="url(#gCuerpo)" d="M100 22 C146 22 168 58 166 98 C178 120 172 188 152 214 C140 232 120 238 100 238 C80 238 60 232 48 214 C28 188 22 120 34 98 C32 58 54 22 100 22 Z"/>
                    <path fill="url(#gSombraCuerpo)" d="M100 22 C146 22 168 58 166 98 C178 120 172 188 152 214 C140 232 120 238 100 238 C80 238 60 232 48 214 C28 188 22 120 34 98 C32 58 54 22 100 22 Z"/>
                    <path fill="none" stroke="url(#gBorde)" stroke-width="2.4" d="M100 22 C146 22 168 58 166 98 C178 120 172 188 152 214 C140 232 120 238 100 238 C80 238 60 232 48 214 C28 188 22 120 34 98 C32 58 54 22 100 22 Z"/>
                    <ellipse cx="100" cy="38" rx="32" ry="11" fill="#fff" opacity=".13"/>
                    <!-- barriguita -->
                    <path fill="url(#gBarriga)" d="M100 120 C134 120 152 152 150 188 C148 216 128 229 100 229 C72 229 52 216 50 188 C48 152 66 120 100 120 Z"/>
                    <path fill="url(#gBarrigaSombra)" d="M100 120 C134 120 152 152 150 188 C148 216 128 229 100 229 C72 229 52 216 50 188 C48 152 66 120 100 120 Z"/>

                    <!-- cabeza: carita en forma de corazón -->
                    <g class="p-cabeza">
                      <path class="p-mechon" fill="url(#gCuerpo)" d="M90 25 Q86 10 95 16 Q99 3 103 16 Q112 8 110 25 Z"/>
                      <path fill="#fffaf2" d="M100 114 C68 114 44 98 44 78 C44 60 62 54 77 58 C88 61 95 67 100 73 C105 67 112 61 123 58 C138 54 156 60 156 78 C156 98 132 114 100 114 Z"/>
                      <circle cx="58" cy="100" r="11" fill="url(#gMejilla)"/>
                      <circle cx="142" cy="100" r="11" fill="url(#gMejilla)"/>

                      <g class="p-ojos">
                        <g class="p-mirada"><g class="p-pupila">
                          <circle cx="77" cy="84" r="11.5" fill="url(#gOjo)"/>
                          <circle cx="80.6" cy="79.6" r="4.2" fill="#fff"/><circle cx="73.4" cy="89" r="1.9" fill="#fff" opacity=".85"/>
                          <circle cx="123" cy="84" r="11.5" fill="url(#gOjo)"/>
                          <circle cx="126.6" cy="79.6" r="4.2" fill="#fff"/><circle cx="119.4" cy="89" r="1.9" fill="#fff" opacity=".85"/>
                        </g></g>
                        <g class="p-parpados">
                          <ellipse cx="77" cy="84" rx="12.6" ry="12.6" fill="#fffaf2"/>
                          <ellipse cx="123" cy="84" rx="12.6" ry="12.6" fill="#fffaf2"/>
                          <path d="M66 87 Q77 96 88 87 M112 87 Q123 96 134 87" fill="none" stroke="#1b2336" stroke-width="2.6" stroke-linecap="round"/>
                        </g>
                      </g>

                      <!-- cejitas (solo se ven en algunos gestos) -->
                      <g class="p-cejas" fill="none" stroke="#1b2336" stroke-width="2.6" stroke-linecap="round">
                        <path class="p-ceja-i" d="M66 68 Q77 62 88 67"/>
                        <path class="p-ceja-d" d="M112 67 Q123 62 134 68"/>
                      </g>

                      <!-- piquito -->
                      <g class="p-pico">
                        <ellipse class="p-boca" cx="100" cy="99" rx="8.5" ry="8.5" fill="#b83a52"/>
                        <ellipse class="p-boca" cx="100" cy="104" rx="5" ry="3.6" fill="#ff8aa0"/>
                        <path class="p-pico-b" fill="url(#gPicoB)" d="M93.5 99 Q100 107 106.5 99 Q105 108.5 100 110 Q95 108.5 93.5 99 Z"/>
                        <path fill="url(#gPico)" d="M91 91 Q100 84 109 91 Q109 102 100 105 Q91 102 91 91 Z"/>
                        <ellipse cx="96" cy="90" rx="2.4" ry="1.5" fill="#fff" opacity=".5"/>
                      </g>
                    </g>
                    <!-- aletitas -->
                    <g class="p-fl-i">
                      <path fill="url(#gAleta)" d="M40 114 C20 124 12 150 22 170 C28 180 40 174 46 164 C54 150 56 130 52 118 Z"/>
                      <path d="M44 124 C32 134 27 150 30 163" fill="none" stroke="#fff" stroke-opacity=".32" stroke-width="2.4" stroke-linecap="round"/>
                    </g>
                    <g class="p-fl-d">
                      <path fill="url(#gAleta)" d="M160 114 C180 124 188 150 178 170 C172 180 160 174 154 164 C146 150 144 130 148 118 Z"/>
                      <path d="M156 124 C168 134 173 150 170 163" fill="none" stroke="#fff" stroke-opacity=".32" stroke-width="2.4" stroke-linecap="round"/>
                    </g>
                  </g>
                </g>

                <!-- efectos -->
                <g transform="translate(84 18)"><path class="p-corazon c1" d="M0 -2 C-3 -8 -11 -5 -7 1 L0 9 L7 1 C11 -5 3 -8 0 -2 Z"/></g>
                <g transform="translate(100 8)"><path class="p-corazon c2" d="M0 -2 C-3 -8 -11 -5 -7 1 L0 9 L7 1 C11 -5 3 -8 0 -2 Z"/></g>
                <g transform="translate(118 20)"><path class="p-corazon c3" d="M0 -2 C-3 -8 -11 -5 -7 1 L0 9 L7 1 C11 -5 3 -8 0 -2 Z"/></g>
                <text class="p-nota n1" x="150" y="46">&#9834;</text>
                <text class="p-nota n2" x="34" y="36">&#9835;</text>
                <text class="p-zzz z1" x="146" y="44">z</text>
                <text class="p-zzz z2" x="158" y="28">Z</text>
                <text class="p-zzz z3" x="172" y="10">Z</text>
              </svg>
            </button>
            <button type="button" class="mascota-pausa" id="mascota-pausa" aria-pressed="false"
                    aria-label="Pausar las animaciones automáticas del pingüino" title="Pausar animaciones automáticas">
              <svg class="ico ico-pausa" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5v14M15 5v14"/></svg>
              <svg class="ico ico-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5l11 7-11 7z"/></svg>
            </button>
          </div>
          <figure class="frase" aria-label="Frase motivadora" aria-live="polite" aria-atomic="true">
            <blockquote><p id="frase-texto">{{ f.texto }}</p></blockquote>
            <figcaption id="frase-autor"{% if not f.autor %} hidden{% endif %}>{{ f.autor }}</figcaption>
            <button type="button" class="frase-otra" id="frase-otra" hidden
                    aria-label="Mostrar otra frase" title="Otra frase">
              <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 11a8 8 0 0 0-14.5-4.4M4 4v4h4M4 13a8 8 0 0 0 14.5 4.4M20 20v-4h-4"/></svg>
            </button>
          </figure>
        </div>
      </div>
    </div>
  </header>

  <main class="wrap" id="contenido" tabindex="-1">
    {% if destacados %}
    <section class="destacados">
      <h2 class="cat-h" id="h-destacados">
        <button type="button" class="cat-header" id="b-destacados" aria-expanded="true" aria-controls="p-destacados">
          <span class="cat-titulo"><span aria-hidden="true">🔥</span> Lo más comentado</span>
          <span class="cat-count"><span class="sr-only">, </span>cubierto por {{ destacados_cobertura_minima }}+ fuentes</span>
        </button>
      </h2>
      <div class="cat-body" id="p-destacados">
        <div class="cat-grid">
          {% for item in destacados %}{{ m.render_item(item, csrf_token, 'd-') }}{% endfor %}
        </div>
      </div>
    </section>
    {% endif %}

    {% for cat, label in categorias_disponibles %}
    {% if cat in categorias_activas %}
    <section class="categoria">
      <h2 class="cat-h" id="h-{{ cat }}">
        <button type="button" class="cat-header" id="b-{{ cat }}" aria-expanded="false" aria-controls="p-{{ cat }}">
          <span class="dot dot-{{ cat }}" aria-hidden="true"></span>
          <span class="cat-titulo">{{ label | emoji_decorativo }}</span>
          <span class="cat-count"><span class="sr-only">, </span>{{ conteo_por_categoria.get(cat, 0) }}<span class="sr-only"> noticias</span></span>
        </button>
      </h2>
      <div class="cat-body" id="p-{{ cat }}" hidden="until-found">
        <div class="cat-grid">
      {% if grupos.get(cat) %}
        {% for item in grupos[cat] %}{{ m.render_item(item, csrf_token) }}{% endfor %}
      {% elif conteo_por_categoria.get(cat, 0) > 0 %}
        <p class="vacio">No hay más resultados en esta página para esta categoría.</p>
      {% else %}
        <p class="vacio">Sin ítems en este rango de días.</p>
      {% endif %}
        </div>
      </div>
    </section>
    {% endif %}
    {% endfor %}

    {% if total_paginas > 1 %}
    <nav class="paginacion" aria-label="Paginación de resultados">
      {% if pagina > 1 %}
        <a href="?dias={{ dias }}{{ categorias_qs }}&pagina={{ pagina - 1 }}" rel="prev"><span aria-hidden="true">←</span> Anterior</a>
      {% else %}
        <span class="paginacion-deshabilitado" aria-hidden="true">← Anterior</span>
      {% endif %}

      <span class="paginacion-estado" aria-current="page">Página {{ pagina }} de {{ total_paginas }}</span>

      {% if pagina < total_paginas %}
        <a href="?dias={{ dias }}{{ categorias_qs }}&pagina={{ pagina + 1 }}" rel="next">Siguiente <span aria-hidden="true">→</span></a>
      {% else %}
        <span class="paginacion-deshabilitado" aria-hidden="true">Siguiente →</span>
      {% endif %}
    </nav>
    {% endif %}
  </main>

  {% include "_footer.html.j2" %}
  <script>
    /* Mejora progresiva: el desplegable de categorías se cierra al pulsar
       fuera o con Escape (devolviendo el foco al botón). Sin JS sigue
       funcionando como <details> nativo. */
    (function () {
      var d = document.querySelector("details.dropdown");
      if (!d) return;
      document.addEventListener("click", function (e) {
        if (d.open && !d.contains(e.target)) d.open = false;
      });
      d.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && d.open) {
          d.open = false;
          d.querySelector("summary").focus();
        }
      });
    })();
  </script>
  <script>
    /* Secciones plegables: botón dentro de un encabezado h2 (aria-expanded +
       aria-controls). Recuerda lo abierto durante la sesión, abre la sección que
       contenga el ancla de la URL y se revela con Ctrl+F (hidden="until-found").
       Sin JavaScript las secciones se muestran abiertas (ver <noscript>). */
    (function () {
      var K = "pingunews-secciones", guardado = {};
      try { guardado = JSON.parse(sessionStorage.getItem(K) || "{}"); } catch (e) {}
      function recuerda(id, abierto) {
        guardado[id] = abierto;
        try { sessionStorage.setItem(K, JSON.stringify(guardado)); } catch (e) {}
      }
      function poner(boton, abrir, guardar) {
        var panel = document.getElementById(boton.getAttribute("aria-controls"));
        boton.setAttribute("aria-expanded", abrir ? "true" : "false");
        if (abrir) panel.removeAttribute("hidden"); else panel.setAttribute("hidden", "until-found");
        if (guardar !== false) recuerda(boton.id, abrir);
      }
      document.querySelectorAll("button.cat-header").forEach(function (boton) {
        var panel = document.getElementById(boton.getAttribute("aria-controls"));
        var inicial = typeof guardado[boton.id] === "boolean" ? guardado[boton.id] : boton.getAttribute("aria-expanded") === "true";
        poner(boton, inicial, false);
        boton.addEventListener("click", function () { poner(boton, boton.getAttribute("aria-expanded") !== "true"); });
        panel.addEventListener("beforematch", function () { boton.setAttribute("aria-expanded", "true"); recuerda(boton.id, true); });
      });
      if (location.hash.length > 1) {
        var destino = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        var panelDestino = destino && destino.closest(".cat-body");
        if (panelDestino && panelDestino.hasAttribute("hidden")) {
          var b = document.querySelector('[aria-controls="' + panelDestino.id + '"]');
          if (b) { poner(b, true); destino.scrollIntoView(); }
        }
      }
    })();
  </script>
  <script>
    /* Mascota: reacciona al clic con una animación al azar, sigue el cursor con
       los ojos y, de vez en cuando, hace cosas por su cuenta (bostezar, mirar,
       saltar...). Las acciones automáticas solo ocurren con la pestaña y el
       pingüino visibles, se pueden pausar con el botón y no se ejecutan si el
       sistema pide "reducir movimiento". */
    (function () {
      var btn = document.getElementById("mascota");
      if (!btn) return;
      var svg = btn.querySelector(".pingu");
      var pausaBtn = document.getElementById("mascota-pausa");
      var reducir = window.matchMedia("(prefers-reduced-motion: reduce)");
      var CLIC = [["a-salto", 1150], ["a-giro", 1550], ["a-baile", 1950], ["a-saludo", 2150],
                  ["a-aleteo", 1550], ["a-sorpresa", 1550], ["a-cosquillas", 1450], ["a-corazones", 2400],
                  ["a-bostezo", 2900], ["a-mira", 2500], ["a-saltito", 1050], ["a-contoneo", 2700],
                  ["a-sacude", 1100], ["a-estira", 2300], ["a-dormita", 3400],
                  ["a-curiosa", 2400], ["a-canta", 2900], ["a-rasca", 2700]];
      var SOLO = ["a-bostezo", "a-mira", "a-saltito", "a-contoneo", "a-sacude", "a-estira",
                  "a-dormita", "a-saludo", "a-aleteo", "a-salto", "a-curiosa", "a-canta", "a-rasca"];
      var DUR = {}, todas = ["a-feliz"];
      CLIC.forEach(function (a) { DUR[a[0]] = a[1]; todas.push(a[0]); });
      var tAnim = null, tSolo = null, actual = null, ultima = "", pausado = false, visible = true;

      try { pausado = localStorage.getItem("pingunews-mascota-pausa") === "1"; } catch (e) {}

      function limpiar() { todas.forEach(function (c) { svg.classList.remove(c); }); }
      function activo() { return !pausado && !reducir.matches && visible && !document.hidden; }
      function vivo() { svg.classList.toggle("vivo", activo()); }
      function pintaPausa() {
        if (!pausaBtn) return;
        pausaBtn.setAttribute("aria-pressed", pausado ? "true" : "false");
        pausaBtn.title = pausado ? "Reanudar animaciones automáticas" : "Pausar animaciones automáticas";
      }

      function reproducir(nombre) {
        clearTimeout(tAnim);
        svg.classList.remove("hola"); limpiar();
        void svg.getBoundingClientRect();           /* reinicia la animación */
        svg.classList.add(nombre); actual = nombre; ultima = nombre;
        tAnim = setTimeout(function () { limpiar(); actual = null; programar(); }, DUR[nombre]);
      }
      function programar() {
        clearTimeout(tSolo);
        if (!activo()) return;
        tSolo = setTimeout(solo, 7000 + Math.random() * 9000);
      }
      function solo() {
        if (actual || !activo()) { programar(); return; }
        var n; do { n = SOLO[Math.floor(Math.random() * SOLO.length)]; } while (n === ultima);
        reproducir(n);
      }
      function actualiza() { vivo(); if (activo()) { if (!actual) programar(); } else clearTimeout(tSolo); }

      btn.addEventListener("click", function () {
        clearTimeout(tAnim); clearTimeout(tSolo);
        svg.classList.remove("hola"); limpiar();
        if (reducir.matches) {
          svg.classList.add("a-feliz"); actual = null;
          tAnim = setTimeout(limpiar, 2000);
          return;
        }
        var n; do { n = CLIC[Math.floor(Math.random() * CLIC.length)][0]; } while (n === ultima);
        reproducir(n);
      });

      if (pausaBtn) {
        pausaBtn.addEventListener("click", function () {
          pausado = !pausado;
          try { localStorage.setItem("pingunews-mascota-pausa", pausado ? "1" : "0"); } catch (e) {}
          pintaPausa(); actualiza();
        });
      }

      document.addEventListener("visibilitychange", actualiza);
      if (reducir.addEventListener) reducir.addEventListener("change", actualiza);
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (es) { visible = es[0].isIntersecting; actualiza(); }).observe(btn);
      }

      /* ojos que siguen al cursor */
      if (!reducir.matches) {
        var px = 0, py = 0, raf = 0;
        var seguir = function () {
          raf = 0;
          var r = svg.getBoundingClientRect();
          var cx = r.left + r.width / 2, cy = r.top + r.height * 0.33;
          var dx = px - cx, dy = py - cy, d = Math.hypot(dx, dy) || 1, k = Math.min(1, d / 260);
          svg.style.setProperty("--ox", (dx / d * 2.6 * k).toFixed(2) + "px");
          svg.style.setProperty("--oy", (dy / d * 2.2 * k).toFixed(2) + "px");
        };
        document.addEventListener("pointermove", function (e) {
          px = e.clientX; py = e.clientY;
          if (!raf) raf = requestAnimationFrame(seguir);
        }, { passive: true });
      }

      window.pinguReacciona = function (n) { if (!reducir.matches && DUR[n]) reproducir(n); };
      pintaPausa();
      setTimeout(function () { svg.classList.remove("hola"); actualiza(); }, 4200);
      vivo();
    })();
  </script>
  <script>
    /* Botón "otra frase": pide otra al servidor sin recargar la página. */
    (function () {
      var btn = document.getElementById("frase-otra");
      if (!btn) return;
      var fig = document.querySelector(".frase");
      var txt = document.getElementById("frase-texto");
      var aut = document.getElementById("frase-autor");
      var reducir = window.matchMedia("(prefers-reduced-motion: reduce)");
      var ocupado = false;
      btn.hidden = false;

      function termina() {
        setTimeout(function () { ocupado = false; btn.classList.remove("girando"); btn.removeAttribute("aria-busy"); }, 500);
      }
      btn.addEventListener("click", function () {
        if (ocupado) return;
        ocupado = true; btn.classList.add("girando"); btn.setAttribute("aria-busy", "true");
        fetch("/frase?actual=" + encodeURIComponent(txt.textContent), {
          headers: { "Accept": "application/json" }, credentials: "same-origin", cache: "no-store"
        })
          .then(function (r) { if (!r.ok) throw new Error("http " + r.status); return r.json(); })
          .then(function (f) {
            fig.classList.add("cambiando");
            setTimeout(function () {
              txt.textContent = f.texto;
              if (f.autor) { aut.textContent = f.autor; aut.hidden = false; } else { aut.hidden = true; }
              fig.classList.remove("cambiando");
            }, reducir.matches ? 0 : 200);
            if (window.pinguReacciona) {
              var gestos = ["a-saltito", "a-curiosa", "a-saludo", "a-mira"];
              window.pinguReacciona(gestos[Math.floor(Math.random() * gestos.length)]);
            }
          })
          .catch(function () { /* se queda la frase actual */ })
          .then(termina);
      });
    })();
  </script>
</body>
</html>
