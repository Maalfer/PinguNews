{% macro render_item(item, csrf_token, ambito='') %}
<article class="item" id="item-{{ ambito }}{{ item.hash }}">
  <a class="titulo" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.titulo }}<span class="sr-only"> (se abre en una pestaña nueva)</span></a>
  <div class="meta">
    <span class="fuente">{{ item.fuente }}</span>
    <span aria-hidden="true">·</span>
    <span>{{ item.fecha_fmt }}</span>
    {% if item.autor %}<span aria-hidden="true">·</span><span>{{ item.autor }}</span>{% endif %}
    {% if item.cobertura and item.cobertura > 1 %}
    <span aria-hidden="true">·</span>
    <span class="badge-cobertura" title="Cubierto también por: {{ item.fuentes_cobertura_lista | join(', ') }}">
      {{ item.cobertura }} fuentes<span class="sr-only">: {{ item.fuentes_cobertura_lista | join(', ') }}</span>
    </span>
    {% endif %}
  </div>
  {% if item.resumen %}<div class="resumen">{{ item.resumen }}</div>{% endif %}
  <div class="acciones-item">
    <form method="post" action="/like/{{ item.hash }}" class="form-accion">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="btn-accion me-gusta {{ 'activo' if item.le_gusta else '' }}"
              aria-pressed="{{ 'true' if item.le_gusta else 'false' }}">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 20.5s-7.5-4.6-9.6-9.4C.9 7.6 3.2 4.5 6.4 4.5c2.1 0 3.9 1.1 5.6 3.2 1.7-2.1 3.5-3.2 5.6-3.2 3.2 0 5.5 3.1 4 6.6-2.1 4.8-9.6 9.4-9.6 9.4z"/></svg>
        <span class="sr-only">Me gusta, </span><span>{{ item.likes }}</span>
      </button>
    </form>
    <form method="post" action="/guardar/{{ item.hash }}" class="form-accion">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="btn-accion {{ 'activo' if item.guardado else '' }}">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg>
        {% if item.guardado %}Guardado{% else %}Guardar{% endif %}<span class="sr-only"> esta noticia</span>
      </button>
    </form>
  </div>
</article>
{% endmacro %}

{% macro auth_area(usuario, csrf_token) %}
<div class="auth-area">
  {% if usuario %}
    <span class="usuario">
      <span class="avatar" aria-hidden="true">{{ usuario.nombre_usuario[:1] | upper }}</span>
      <span class="usuario-nombre"><span class="sr-only">Sesión iniciada como </span>{{ usuario.nombre_usuario }}</span>
    </span>
    <a class="btn-ghost" href="/guardados">
      <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg>
      Mis guardados
    </a>
    <form method="post" action="/logout" class="form-salir">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <button type="submit" class="btn-ghost">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 21H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h4M16 17l5-5-5-5M21 12H9"/></svg>
        Cerrar sesión
      </button>
    </form>
  {% else %}
    <a class="btn-ghost" href="/login">Iniciar sesión</a>
    <a class="btn-solid" href="/registro">Crear cuenta</a>
  {% endif %}
</div>
{% endmacro %}
