<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crear cuenta — PinguNews</title>
{% include "_favicon.html.j2" %}
{% include "_estilos.html.j2" %}
</head>
<body class="auth-body">
  {% import "_macros.html.j2" as m %}
  <main class="auth-main" id="contenido">
    <div class="auth-escena">
      <div class="auth-pingu" aria-hidden="true">{{ m.pingu(116) }}</div>

      <div class="auth-card">
        <p class="auth-marca">PinguNews</p>
        <h1>Crea tu cuenta</h1>
        <p class="auth-sub">Guarda las noticias que te interesan y dales me gusta.</p>

        {% if error %}<p class="auth-error" id="auth-error" role="alert"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.4v.1"/></svg><span>{{ error }}</span></p>{% endif %}

        <form method="post" action="/registro">
          <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="campo">
        <label for="nombre_usuario">Usuario</label>
        <div class="campo-caja">
          <svg class="campo-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg>
          <input type="text" id="nombre_usuario" name="nombre_usuario" aria-describedby="nombre_usuario-ayuda{% if error %} auth-error{% endif %}" autocomplete="username" autocapitalize="none" spellcheck="false" minlength="3" required>
        </div>
        <p class="campo-ayuda" id="nombre_usuario-ayuda">Mínimo 3 caracteres.</p>
      </div>
      <div class="campo">
        <label for="password">Contraseña</label>
        <div class="campo-caja">
          <svg class="campo-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
          <input type="password" id="password" name="password" data-pw aria-describedby="password-ayuda{% if error %} auth-error{% endif %}" autocomplete="new-password" minlength="8" required>
          <button type="button" class="btn-ojo" data-for="password" data-nombre="contraseña" hidden aria-pressed="false" aria-label="Mostrar contraseña"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
        <p class="campo-ayuda" id="password-ayuda">Mínimo 8 caracteres.</p>
      </div>
      <div class="campo">
        <label for="password2">Repite la contraseña</label>
        <div class="campo-caja">
          <svg class="campo-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
          <input type="password" id="password2" name="password2" data-pw autocomplete="new-password" minlength="8" required{% if error %} aria-describedby="auth-error"{% endif %}>
          <button type="button" class="btn-ojo" data-for="password2" data-nombre="contraseña repetida" hidden aria-pressed="false" aria-label="Mostrar contraseña repetida"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button>
        </div>
      </div>
          <button type="submit" class="btn btn-primario btn-grande">Crear cuenta</button>
        </form>

        <div class="auth-separador" aria-hidden="true"><span>o</span></div>
        <p class="auth-enlace">¿Ya tienes cuenta?</p>
        <a class="btn-ghost btn-bloque" href="/login">Iniciar sesión</a>
      </div>

      <p class="auth-volver"><a class="btn-ghost" href="/">
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
        Volver al panel
      </a></p>
    </div>
  </main>
  {% include "_footer.html.j2" %}
  {% include "_auth_script.html.j2" %}
</body>
</html>
