<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crear cuenta — Panel de ciberseguridad &amp; IT</title>
{% include "_favicon.html.j2" %}
{% include "_estilos.html.j2" %}
</head>
<body>
  <div class="auth-card">
    <div class="auth-logo"><img src="/static/logo.png" alt="Panel de ciberseguridad &amp; IT" width="72" height="72"></div>
    <h1>Crear cuenta</h1>
    {% if error %}<p class="auth-error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="/registro">
      <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
      <div class="campo">
        <label for="nombre_usuario">Usuario (mínimo 3 caracteres)</label>
        <input type="text" id="nombre_usuario" name="nombre_usuario" autocomplete="username" minlength="3" required autofocus>
      </div>
      <div class="campo">
        <label for="password">Contraseña (mínimo 8 caracteres)</label>
        <input type="password" id="password" name="password" autocomplete="new-password" minlength="8" required>
      </div>
      <div class="campo">
        <label for="password2">Repite la contraseña</label>
        <input type="password" id="password2" name="password2" autocomplete="new-password" minlength="8" required>
      </div>
      <button type="submit" class="btn btn-primario">Crear cuenta</button>
    </form>
    <p class="auth-enlace">¿Ya tienes cuenta? <a href="/login">Iniciar sesión</a></p>
  </div>
</body>
</html>
